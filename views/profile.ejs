<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="min-h-screen w-ful bg-zinc-900 text-white p-10">
      <div class="nav flex justify-between items-center">
        <h3 class="text-3xl tracking-tighter mb-4">Profile</h3>
        <a
          class="w-20 h-8 bg-red-600 flex items-center justify-center rounded-md"
          href="/logout"
          >Logout</a
        > 
      </div>

      <div class="content p-2">
        <h2 class="text-xl tracking-tighter">Hello , <%=user.username%> 👋</h2>
        <h3 class="tracking-tighter">you can create a new post.</h3>
        <form action="/post" method="post" class="flex flex-col gap-3">
          <textarea
            class="mt-4 resize-none border-2 outline-none border-zinc-800 rounded-md w-1/3 h-20 px-2 py-2"
            name="content"
            placeholder="what's on your mind?"
          ></textarea>
          <input
            class="w-40 h-8 px-4 py-1 bg-sky-700 text-base rounded-md tracking-tighter"
            type="submit"
            value="Create new post"
          />
        </form>

        <div class="posts pt-15">
          <h2 class="text-zinc-300">Your Posts</h2>
          <%user.posts.reverse().forEach(function(val){%>
  <div
            class="post h-40 mt-4 py-2 px-2 w-1/3 bg-zinc-800 border-[1px] rounded-md outline-none border-zinc-700"
          >
            <h3 class="text-sky-500">@<%=user.username%></h3>
            <p class="py-2 tracking-tighter">
             <%=val.content%>
            </p>
            <p><%=val.likes.length%> likes</p>
            <div class="flex flex-row gap-4">
              <a class="text-sky-500" href="/likes/<%= val._id %>" >
                <%= val.likes.indexOf(user._id) === -1 ? "Like":"Unlike"%>
              </a>
              
              <a class="text-zinc-600" href="/edit/<%=val._id%>">edit post</a>
              <a class="text-red-500" href="/delete/<%=val._id%>">delete </a>
            </div>
          </div>
          <%})%>
        
        </div>
      </div>
    </div>
  </body>
</html>
