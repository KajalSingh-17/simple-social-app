<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="min-h-screen w-ful bg-zinc-900 text-white p-10">
      <div class="nav flex justify-between items-center">
        <h3 class="text-3xl tracking-tighter mb-4">Edit</h3>
        <a
          class="w-20 h-8 bg-red-600 flex items-center justify-center rounded-md"
          href="/logout"
          >Logout</a
        > 
      </div>

      <div class="content p-2">
       
        <form action="/update/<%=post._id%>" method="post" class="flex flex-col gap-3">
          <textarea
            class="mt-4 resize-none border-2 outline-none border-zinc-800 rounded-md w-1/3 h-20 px-2 py-2"
            name="content"
         
          ><%=post.content%></textarea>
          <input
            class="w-40 h-8 px-4 py-1 bg-sky-700 text-base rounded-md tracking-tighter"
            type="submit"
            value="Edit Post"
          />
        </form>

       
      </div>
    </div>
  </body>
</html>
