<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="h-screen w-full bg-zinc-900 text-white p-10">
      <h3 class="text-3xl tracking-tighter mb-4">Login User</h3>
      <form action="/login" method="post" class="flex gap-4">
        <input 
          class="w-50 bg-transparent border-2 border-zinc-800 outline-none h-10 rounded-md px-3 py-5"
          type="text"
          placeholder="username"
          name="username"
        />
        <input
          class="w-50 bg-transparent border-2 border-zinc-800 outline-none h-10 rounded-md px-3 py-5"
          type="password"
          placeholder="password"
          name="password"
        />

        <input
          class="w-40 bg-sky-500 border-2 border-zinc-800 outline-none h-11 text-lg rounded-md"
          type="Submit"
          value="Login"
        />
      </form>
    </div>
  </body>
</html>
